# ==============================================================================
# WorkSphere Environment Configuration
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env ขึ้น Git)
# ==============================================================================

NODE_ENV="development"
LOG_LEVEL="info"

# URL หลักของเว็บแอปพลิเคชัน (ใช้ตรวจ Origin ป้องกัน CSRF และสร้างลิงก์ในอีเมล)
APP_URL="http://localhost:3000"

# พอร์ตของ Socket.IO Realtime Server (รันแยกโปรเซสคู่กับ Next.js)
REALTIME_PORT="3001"
NEXT_PUBLIC_REALTIME_URL="http://localhost:3001"

# PostgreSQL (เช่น Neon Serverless Postgres หรือจาก docker-compose.yml)
DATABASE_URL="postgresql://worksphere:worksphere@localhost:5432/worksphere?schema=public"

# Secret สำหรับเซ็น Access Token อายุสั้น (ควรมีความยาวอย่างน้อย 32 ตัวอักษร)
AUTH_SECRET="change-me-in-development-at-least-32-chars-long"

# Redis (เช่น Upstash rediss://... หรือ redis://localhost:6379)
# หากเว้นว่างในโหมด development ระบบจะใช้ In-Memory Cache/RateLimiter แทนชั่วคราว
REDIS_URL=""

# File Storage ("local" เก็บลง .local-storage สำหรับ dev | "s3" สำหรับ MinIO / Cloudflare R2 / AWS S3)
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR=".local-storage"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="worksphere-attachments"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Mailer ("console" พิมพ์ลิงก์ออก log สำหรับ dev | "smtp" สำหรับ Mailpit / Production)
MAIL_DRIVER="console"
MAIL_FROM="noreply@worksphere.local"
